# ============================================================
# MKT-Workshop-Ops — GitHub Actions Secrets & Variables
# ============================================================
# Copy this file to .env, fill in your values, then use it as
# a reference when entering them in GitHub:
#   Settings → Secrets and variables → Actions
#
# NEVER commit .env — it is already in .gitignore.
# Secrets go under the Secrets tab (New repository secret).
# Variables go under the Variables tab (New repository variable).
# ============================================================


# ------------------------------------------------------------
# SECRETS
# ------------------------------------------------------------

# --- MC Events 3 org (default) ---
MC_EVENTS_3_SUBDOMAIN=
MC_EVENTS_3_CLIENT_ID=
MC_EVENTS_3_CLIENT_SECRET=

# --- MC Events 2 org ---
MC_EVENTS_2_SUBDOMAIN=
MC_EVENTS_2_CLIENT_ID=
MC_EVENTS_2_CLIENT_SECRET=

# --- Shared ---
DEFAULT_USER_PASSWORD=

# --- Create Instructor User ---
INSTRUCTOR_USER_PASSWORD=journey@1


